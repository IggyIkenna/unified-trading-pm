# act secrets — EXAMPLE TEMPLATE
# Copy this file to <workspace-root>/.act-secrets and fill in real values.
# NEVER commit .act-secrets — it is gitignored at the workspace root.
#
# Setup: bash unified-trading-pm/scripts/workspace/generate-act-secrets.sh

# GitHub Personal Access Token
# Create at: https://github.com/settings/tokens
# Required scopes: repo, read:packages
GH_PAT=

# Anthropic API key (local act simulation only — already set on GitHub for CI)
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Telegram notifications (optional — propagate to all repos via scripts/workspace/propagate-github-secrets.sh)
# Create bot: @BotFather on Telegram → /newbot → copy token
# Get chat ID: add @userinfobot to your group or message it directly
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
