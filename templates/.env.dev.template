# =============================================================================
# Unified Trading System — Dev Environment Template
# =============================================================================
# Copy this file to .env.dev:
#   cp .env.dev.template .env.dev
#
# Then edit .env.dev to fill in REQUIRED values (marked below).
# DEFAULT values are safe as-is for local development.
# VCR values only need real keys if you set VCR_MODE=record or =disabled.
#
# Full reference: unified-trading-pm/docs/dev-environment-vars.md
# SSOT: unified-config-interface/unified_config_interface/cloud_config.py
#
# Tags used in this file:
#   REQUIRED — needs a real value before services will start
#   DEFAULT  — safe default; override only when needed
#   VCR      — placeholder is fine when VCR_MODE=playback
# =============================================================================

# =============================================================================
# RUNTIME MODE
# =============================================================================

# DEFAULT — Runtime environment
ENVIRONMENT=development

# DEFAULT — Active cloud backend: gcp | aws
CLOUD_PROVIDER=gcp

# DEFAULT — true = in-memory mocks for GCS/PubSub; no real credentials needed
CLOUD_MOCK_MODE=true

# DEFAULT — false = read API keys from env vars below (not Secret Manager)
USE_SECRET_MANAGER=false

# DEFAULT — Service execution mode: batch | live
RUNTIME_MODE=batch

# DEFAULT — Python logging level
LOG_LEVEL=DEBUG

# DEFAULT — VCR cassette mode: playback | record | disabled
# playback = use committed cassettes (no live API calls)
# record   = make live API calls and write cassettes (needs real keys below)
# disabled = live API calls with no cassettes (needs real keys below)
VCR_MODE=playback

# DEFAULT — API key shard index for rotation (use 0 locally)
SHARD_INDEX=0

# =============================================================================
# GCP AUTH
# =============================================================================

# REQUIRED — GCP project for dev
GCP_PROJECT_ID=unified-trading-dev

# REQUIRED — Path to GCP service-account key JSON
# Alternative: run `gcloud auth application-default login` and leave this unset
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/dev-sa-key.json

# DEFAULT — GCS region
GCS_REGION=us-central1

# DEFAULT — GCS multi-region location
GCS_LOCATION=US

# =============================================================================
# AWS (testnet / paper trading)
# =============================================================================

# DEFAULT — AWS CLI named profile for testnet
AWS_PROFILE=unified-trading-dev

# DEFAULT — AWS region
AWS_REGION=us-east-1

# DEFAULT — AWS account ID (used for ECR image URIs)
# AWS_ACCOUNT_ID=

# =============================================================================
# GCS BUCKETS (GCP)
# =============================================================================

# DEFAULT — Market data buckets (replace {project_id} with your GCP project ID)
MARKET_DATA_GCS_BUCKET=market-data-tick
MARKET_DATA_GCS_BUCKET_CEFI=market-data-tick-cefi-unified-trading-dev
MARKET_DATA_GCS_BUCKET_TRADFI=market-data-tick-tradfi-unified-trading-dev
MARKET_DATA_GCS_BUCKET_DEFI=market-data-tick-defi-unified-trading-dev

# DEFAULT — Features bucket
FEATURES_GCS_BUCKET=features-data

# DEFAULT — Execution/backtest results bucket
# EXECUTION_GCS_BUCKET=execution-store-cefi-unified-trading-dev

# DEFAULT — Instruments bucket
# INSTRUMENTS_GCS_BUCKET=instruments-store-cefi-unified-trading-dev

# =============================================================================
# BIGQUERY
# =============================================================================

# DEFAULT — BigQuery datasets
BIGQUERY_DATASET=market_data
MARKET_DATA_BIGQUERY_DATASET=market_tick_data
EXECUTION_BIGQUERY_DATASET=execution
INSTRUMENTS_BIGQUERY_DATASET=instruments

# =============================================================================
# DATABASE (execution-service live mode only)
# =============================================================================

# DEFAULT — false = use in-memory adapters (no PostgreSQL needed)
USE_DATABASE=false

# DEFAULT — PostgreSQL connection string (only used when USE_DATABASE=true)
# DATABASE_URL=postgresql://user:password@localhost:5432/execution_db

# =============================================================================
# API KEYS — DATA PROVIDERS
# All are VCR-safe with VCR_MODE=playback.
# Fill in real keys only when VCR_MODE=record or VCR_MODE=disabled.
# =============================================================================

# VCR — Tardis.dev (CeFi market data)
TARDIS_API_KEY=vcr_placeholder
TARDIS_SECRET_NAME=tardis-api-key
TARDIS_FULL_SECRET_NAME=tardis-api-key-full
TARDIS_BASE_URL=https://api.tardis.dev/v1
TARDIS_DATASETS_URL=https://datasets.tardis.dev/v1
TARDIS_TIMEOUT=30
TARDIS_MAX_RETRIES=3

# VCR — Databento (CeFi tick data)
DATABENTO_API_KEY=vcr_placeholder
DATABENTO_SECRET_NAME=databento-api-key
DATABENTO_TIMEOUT=60

# =============================================================================
# API KEYS — BROKERS (CeFi execution)
# VCR-safe with VCR_MODE=playback.
# For real testnet keys, see unified-trading-pm/docs/testnet-api-keys.md
# =============================================================================

# VCR — Binance testnet (https://testnet.binance.vision)
BINANCE_API_KEY=vcr_placeholder
BINANCE_API_SECRET=vcr_placeholder
BINANCE_SECRET_NAME=binance-api

# VCR — Deribit testnet (https://test.deribit.com)
DERIBIT_API_KEY=vcr_placeholder
DERIBIT_API_SECRET=vcr_placeholder
DERIBIT_SECRET_NAME=deribit-api

# DEFAULT — Hyperliquid
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
HYPERLIQUID_SECRET_NAME=hyperliquid-api

# DEFAULT — IBKR paper trading (IB Gateway must be running locally)
IBKR_GATEWAY_HOST=127.0.0.1
IBKR_GATEWAY_PORT=4001
IBKR_CLIENT_ID_BASE=1
IBKR_CREDENTIALS_SECRET_NAME=ibkr-account-credentials

# =============================================================================
# API KEYS — DEFI
# VCR-safe with VCR_MODE=playback.
# =============================================================================

# VCR — Alchemy (Ethereum/L2 RPC)
ALCHEMY_API_KEY=vcr_placeholder
ALCHEMY_SECRET_NAME=alchemy-api-key
ALCHEMY_DEFAULT_CHAIN=ETHEREUM
ALCHEMY_TIMEOUT=30

# VCR — The Graph (DeFi protocol data)
THE_GRAPH_API_KEY=vcr_placeholder
THEGRAPH_SECRET_NAME=thegraph-api-key
THEGRAPH_GATEWAY_URL=https://gateway.thegraph.com/api
THEGRAPH_STUDIO_URL=https://api.studio.thegraph.com/query
THEGRAPH_TIMEOUT=30

# VCR — AaveScan
AAVESCAN_API_KEY=vcr_placeholder
AAVESCAN_SECRET_NAME=aavescan-api-key

# =============================================================================
# OBSERVABILITY
# =============================================================================

# DEFAULT — OpenTelemetry OTLP endpoint (local Jaeger or OTEL Collector)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# =============================================================================
# DEV TOOLS
# =============================================================================

# DEFAULT — GitHub PAT (repo scope). Optional if SSH is configured.
# GH_PAT=

# DEFAULT — CSV sampling for debugging
ENABLE_CSV_SAMPLING=false
CSV_SAMPLE_SIZE=20000
CSV_SAMPLE_DIR=data/samples

# DEFAULT — Auth disabled on local API servers for easier curl/Postman access
DISABLE_AUTH=true
