{
  "folders": [
    {
      "path": "../..",
      "name": "\ud83d\udcc1 Workspace Root"
    },
    {
      "path": "../../.cursor",
      "name": "\u2699\ufe0f Cursor Config"
    },
    {
      "path": "../../.venv-workspace",
      "name": "\ud83d\udc0d Venv"
    },
    {
      "path": "../../unified-trading-codex",
      "name": "\ud83d\udcda Codex"
    },
    {
      "path": "../../unified-trading-pm",
      "name": "\ud83d\udccb PM"
    },
    {
      "path": "../../unified-trading-system-ui",
      "name": "\ud83c\udfa8 UI"
    },
    {
      "path": "../../deployment-ui",
      "name": "\ud83d\udee0\ufe0f Deployment UI"
    }
  ],
  "settings": {
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv-workspace/bin/python",
    "python.terminal.activateEnvironment": true,
    "python.envFile": "${workspaceFolder}/.env",
    "cursorpyright.analysis.typeCheckingMode": "strict",
    "cursorpyright.analysis.autoSearchPaths": true,
    "cursorpyright.analysis.autoImportCompletions": true,
    "cursorpyright.analysis.useLibraryCodeForTypes": true,
    "cursorpyright.analysis.indexing": false,
    "cursorpyright.analysis.inlayHints.variableTypes": true,
    "cursorpyright.analysis.inlayHints.functionReturnTypes": true,
    "cursorpyright.analysis.reportAny": "error",
    "cursorpyright.analysis.reportUnknownMemberType": "error",
    "cursorpyright.analysis.reportUnknownVariableType": "error",
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestArgs": [
      "tests",
      "-v"
    ],
    "files.autoSave": "onFocusChange",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports": "explicit"
    },
    "[python]": {
      "editor.defaultFormatter": "charliermarsh.ruff",
      "editor.formatOnSave": true,
      "editor.codeActionsOnSave": {
        "source.fixAll": "explicit",
        "source.organizeImports": "explicit"
      }
    },
    "ruff.enable": true,
    "ruff.lint.enable": true,
    "ruff.lint.select": [
      "E",
      "F",
      "W",
      "I"
    ],
    "ruff.lineLength": 120,
    "ruff.organizeImports": true,
    "ruff.fixAll": true,
    "ruff.path": "${workspaceFolder}/.venv-workspace/bin/ruff",
    "ruff.format.args": [
      "--line-length",
      "120"
    ],
    "files.exclude": {
      "**/__pycache__": true,
      "**/*.pyc": true,
      "**/.pytest_cache": true,
      "**/.ruff_cache": true,
      "**/.venv": true,
      "**/.pixi": true,
      "**/.venv.backup": true,
      "**/uv.lock": false
    },
    "files.watcherExclude": {
      "**/.git/objects/**": true,
      "**/.git/subtree-cache/**": true,
      "**/node_modules/**": true,
      "**/.hg/store/**": true,
      "**/.pixi/**": true,
      "**/.venv/**": true,
      "**/.venv-*/**": true,
      "**/venv/**": true,
      "**/.next/**": true,
      "**/dist/**": true,
      "**/build/**": true,
      "**/.turbo/**": true,
      "**/__pycache__/**": true,
      "**/.mypy_cache/**": true,
      "**/.ruff_cache/**": true,
      "**/.pytest_cache/**": true,
      "**/.hypothesis/**": true,
      "**/.cache/**": true,
      "**/.nyc_output/**": true,
      "**/htmlcov/**": true,
      "**/coverage/**": true
    },
    "search.exclude": {
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "**/.ruff_cache": true,
      "**/.venv": true,
      "**/uv.lock": false
    },
    "editor.insertSpaces": true,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "typescript.tsdk": "node_modules/typescript/lib"
  }
}
