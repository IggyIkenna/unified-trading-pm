{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash",
      "Git",
      "Grep",
      "Global",
      "Read",
      "WebFetch",
      "mcp__claude_ai_Context7__resolve-library-id",
      "mcp__claude_ai_Context7__query-docs",
      "Monitor",
      "Workflow",
      "Agent",
      "ScheduleWakeup",
      "TaskOutput",
      "TaskStop",
      "SendMessage",
      "TodoWrite",
      "Read(//home/ubuntu/unified-trading-pm/scripts/quality-gates-base/**)",
      "Read(//home/ubuntu/unified-trading-library/unified_trading_library/streaming/**)",
      "Read(//home/ubuntu/unified-trading-library/unified_trading_library/**)"
    ],
    "deny": [],
    "ask": []
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true
  },
  "skipDangerousModePermissionPrompt": true,
  "switchModelsOnFlag": true,
  "agentPushNotifEnabled": true,
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest", "--output-dir", ".playwright-mcp"],
      "env": {
        "PLAYWRIGHT_HEADLESS": "false"
      }
    }
  }
}
