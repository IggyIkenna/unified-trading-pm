{
  "cleanupPeriodDays": 30,
  "permissions": {
    "allow": [
      "Bash(*)",
      "Bash",
      "Read",
      "Write",
      "Edit",
      "NotebookEdit",
      "Grep",
      "Glob",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Skill",
      "Workflow",
      "Monitor",
      "ScheduleWakeup",
      "TaskOutput",
      "TaskStop",
      "SendMessage",
      "TodoWrite",
      "ListAgents",
      "mcp__playwright",
      "mcp__dune",
      "mcp__claude_ai_Context7"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "bypassPermissions"
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": false
  },
  "skipDangerousModePermissionPrompt": true,
  "switchModelsOnFlag": true,
  "agentPushNotifEnabled": true,
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest", "--output-dir", ".playwright-mcp"],
      "env": {
        "PLAYWRIGHT_HEADLESS": "false"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/agent-orchestrator/scripts/hooks/block_destructive_commands.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/unified-trading-pm/cursor-configs/hooks/context-threshold-nudge.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Read|Grep|Glob|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/unified-trading-pm/cursor-configs/hooks/batching-nudge.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/unified-trading-pm/cursor-configs/hooks/session-start-collision-check.sh"
          }
        ]
      }
    ]
  },
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  }
}
