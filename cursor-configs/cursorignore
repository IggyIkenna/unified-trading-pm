# =============================================================================
# Central .cursorignore — workspace SSOT (reduce Cursor index size)
# Canonical: unified-trading-pm/cursor-configs/cursorignore
# Workspace root symlink: .cursorignore → unified-trading-pm/cursor-configs/cursorignore
# PM repo symlink: unified-trading-pm/.cursorignore → cursor-configs/cursorignore
# =============================================================================

# Venvs and runtimes
**/.venv/
**/.venv-*/
**/venv/
**/.venv-workspace/

# Node
**/node_modules/
**/.next/
**/dist/
**/build/
**/.turbo/

# Python caches and artifacts
**/__pycache__/
**/.mypy_cache/
**/.hypothesis/
**/.ruff_cache/
**/.pytest_cache/
**/.cache/
**/*.egg-info/

# Data and logs (often large)
**/data/
**/logs/

# Common data / document file types (large or binary)
**/*.csv
**/*.tsv
**/*.parquet
**/*.xlsx
**/*.xls
**/*.xlsm
**/*.ppt
**/*.pptx
**/*.pptm
**/*.doc
**/*.docx
**/*.docm
**/*.pdf
**/*.ods
**/*.odt
**/*.odp

# Coverage and test output
**/htmlcov/
**/.coverage
**/coverage/
**/.nyc_output/

# IDE / OS
**/.idea/
**/.vscode/
**/.DS_Store

# Boilerplate and low-value config files
**/LICENSE
**/.gitignore
**/.actrc
**/index.html
**/vite-env.d.ts
**/.gitkeep
**/.python-version

# Backup and dump files
**/*.bak

# Generated configs — machine-generated, low semantic value
**/configs/generated/**

# Temp audit docs
**/docs/.temp-audit/**

# Build/config metadata
**/.dependency-matrix.json
**/pip.conf

# Archived docs — low indexing value
unified-trading-pm/github-integration/archived/

# Sub-repo .cursor/rules — all point to the same physical cursor-rules/ dir as workspace root.
# Excluded from indexing to avoid duplicate file context in full workspace sessions.
# Rules still load correctly via nearest-ancestor semantics when a single repo is opened directly.
*/.cursor/
*/.cursor/**

# Optional: Terraform (uncomment if used)
# **/.terraform/
# **/*.tfstate
# **/*.tfstate.*
