# features-volatility-service — batch mode protocol config
# Injected by deployment bootstrap into Cloud Run / ECS task at deploy time.
# All defaults here are for GCP. For AWS, swap gcs→s3 and update bucket names.
# For local dev / CI: leave PROTOCOL_DATA_SINK_BACKEND=local (default) — no credentials needed.
#
# STALE (confirmed 2026-07-25, bucket_estate_consolidation_closeout_2026_07_24.md, asset-group parity drift
# cleanup): the PROTOCOL_DATA_SINK_BUCKET_* / PROTOCOL_DATA_SOURCE_BUCKET_* values below use the pre-SSOT
# `uts-prod-{kind}-{ag}` naming scheme (no `${GCP_PROJECT_ID}` templating, unlike PROTOCOL_EVENT_BUS_PROJECT
# below) and match no bucket in the current estate — the closest live equivalent would be the folded
# `features-{ag}-prd-${GCP_PROJECT_ID}` (Fold A) / `market-data-{ag}-prd-${GCP_PROJECT_ID}`. This repo
# (unified-trading-pm) has no `configs/services/` consumer wired to it — the actual deployment-bootstrap
# script (`deployment-service/scripts/bootstrap/bootstrap_gcp.sh`) reads `$REPO_ROOT/configs/services/` from
# ITS OWN repo root, which has no `features-volatility-service` entry today — so this file is not confirmed
# to be live-injected anywhere. Left un-rewritten (not "corrected" to the new shape) rather than guess at an
# unverified value; if this mechanism is revived, re-derive the values from `resolve_bucket_name` /
# cloud-providers.yaml instead of hand-editing this file.

SERVICE_MODE=batch

# Data sink — category-specific feature output buckets
PROTOCOL_DATA_SINK_BACKEND=gcs
PROTOCOL_DATA_SINK_BUCKET_CEFI=uts-prod-features-volatility-cefi
PROTOCOL_DATA_SINK_BUCKET_TRADFI=uts-prod-features-volatility-tradfi
PROTOCOL_DATA_SINK_BUCKET_DEFI=uts-prod-features-volatility-defi
PROTOCOL_DATA_SINK_PATH_PREFIX=by_date
PROTOCOL_DATA_SINK_FORMAT=parquet

# Data source — read from market-data buckets (upstream)
PROTOCOL_DATA_SOURCE_BACKEND=gcs
PROTOCOL_DATA_SOURCE_BUCKET_CEFI=uts-prod-market-data-cefi
PROTOCOL_DATA_SOURCE_BUCKET_TRADFI=uts-prod-market-data-tradfi
PROTOCOL_DATA_SOURCE_BUCKET_DEFI=uts-prod-market-data-defi

# Event bus — publishes features.volatility.computed after each batch
PROTOCOL_EVENT_BUS_BACKEND=pubsub
PROTOCOL_EVENT_BUS_TOPIC_PREFIX=features_volatility
PROTOCOL_EVENT_BUS_PROJECT=${GCP_PROJECT_ID}

# Config / secrets
PROTOCOL_CONFIG_STORE_BACKEND=secretmanager
