#!/usr/bin/env bash
# Epic: infrastructure_master
# Lifecycle: permanent
# Delete-when: NA
#
# pre-push — THREE chained guards. This file IS the installed hook (install-hooks.sh copies it to
# every repo's .git/hooks/pre-push), so it must carry both.
#
#   [1] strict-quickmerge (BLOCKS) — CODE reaching live-defi-rollout/staging/main must have gone
#       through quickmerge (`Quickmerge:` trailer) or be a carve-out.
#   [2] dep-alignment (staging only) — this hook's original behaviour, unchanged.
#
# WHY [1] IS HERE NOW (2026-07-17). Guard [1] already existed at
# scripts/dev/hooks/pre-push-strict-quickmerge.sh but was installed in ZERO of 25 clones:
# install-hooks.sh copies THIS path, which only ever held guard [2] — and guard [2] returns 0 for
# every non-staging push. The fleet default is LDR→main DIRECT with staging BYPASSED, so no push
# ever matched and nothing was enforced. Measured: market-tick-data-service accumulated 26 and
# deployment-api 7 non-quickmerge CODE commits; the LDR→main bot's D1 provenance gate then
# correctly refused to promote them, surfacing only as anonymous "PROMOTION LAG" (~23h for mtds).
#
# SCOPE (operator ruling 2026-07-17): "outside pm repo block anything that's not quickmerge".
# unified-trading-pm is EXEMPT from [1] — its scripts/** + .github/** direct pushes are the
# sanctioned carve-out that unblocks the pipeline (gating a PM pipeline-fix behind a promote PR
# that is itself broken is a deadlock). PM still runs [2].
#
# Carve-outs are the guard's own closed set (check_strict_quickmerge.py:105-123): merge/reconcile
# commits, already-promoted commits, bot/[skip ci] authors, and any commit touching NO source
# (docs/plans/codex/scripts/.github, *.md/*.yaml/... via CARVE_PREFIX/CARVE_EXT). A docs or plan
# push is therefore unaffected in every repo.
#
# ESCAPE HATCH: `git push --no-verify` skips this hook. It is the local floor, NOT the backstop —
# the LDR→main provenance gate still refuses to promote a bypassed commit, so --no-verify buys a
# push, never a promotion. Use quickmerge.
#
# stdin: <local_ref> <local_sha> <remote_ref> <remote_sha>  (one line per pushed ref)

set -uo pipefail

REMOTE="${1:-origin}"

# stdin is consumable ONCE — capture it and replay to EVERY guard below.
STDIN_DATA="$(cat)"

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
REPO_NAME="$(basename "$REPO_ROOT")"

# Resolve the workspace root (the dir holding unified-trading-pm) by walking up. The old
# "two levels up" assumption below was also wrong for main-workspace clones (one level up).
_ws="${UNIFIED_TRADING_WORKSPACE_ROOT:-}"
if [ -z "$_ws" ]; then
  _d="$REPO_ROOT"
  while [ "$_d" != "/" ] && [ ! -d "$_d/unified-trading-pm/scripts/cicd" ]; do _d="$(dirname "$_d")"; done
  _ws="$_d"
fi

# ── [0] branch-deletion guard (BLOCKS) ─────────────────────────────────────────────────────────
# Defense-in-depth against the "empty-refspec" bug class: when a variable in a
# `git push origin <var>:<branch>` refspec is unset, the command collapses to
# `git push origin :<branch>`, which DELETES the remote branch. The GitHub ruleset
# (protect-live-defi-rollout) is the server-side backstop; this is the client-side
# guard that catches the bug BEFORE it reaches `git push`.
#
# Blocks: any push where the LOCAL side of the refspec is empty/deleted (local_sha
# is all-zeros) AND the remote ref is a protected branch.
#
# Carve-out: `git push --no-verify` skips this guard — same escape hatch as every
# other guard in this hook. The server-side ruleset still backstops.
_DELETE_PROTECTED="refs/heads/live-defi-rollout refs/heads/main refs/heads/staging"
while read -r _lref _lsha _rref _rsha; do
  [ -z "${_rref:-}" ] && continue
  # All-zeros local SHA = delete (empty left side of refspec, or `git push -d`).
  [ "${_lsha:-}" = "0000000000000000000000000000000000000000" ] || continue
  case " $_DELETE_PROTECTED " in
    *" $_rref "*) : ;;
    *) continue ;;
  esac
  echo ""
  echo "  ⛔ pre-push BLOCKED — branch DELETION of ${_rref} is not allowed."
  echo "     An empty left-hand side of a git-push refspec (e.g."
  echo "     'git push origin :<branch>') means DELETE the remote branch."
  echo "     This is often a bug — an unset shell variable collapsing to empty."
  echo "     The server-side ruleset also blocks this; this hook catches it"
  echo "     earlier (defense in depth)."
  echo "     If you genuinely need to delete this branch, use:"
  echo "       git push --no-verify origin :${_rref##refs/heads/}"
  exit 1
done <<<"$STDIN_DATA"

# ── [1] strict-quickmerge guard (BLOCKS) ──────────────────────────────────────────────────────
_guard="${_ws}/unified-trading-pm/scripts/cicd/check_strict_quickmerge.py"
if [ "$REPO_NAME" = "unified-trading-pm" ]; then
  : # PM exempt — sanctioned carve-out path (see SCOPE above).
elif [ ! -f "$_guard" ]; then
  # Guard missing → no-op. NEVER block a push on a missing tool: a broken workspace checkout must
  # not become an unpushable one. The server-side provenance gate still backstops promotion.
  echo "pre-push: strict-quickmerge guard not found at ${_guard} — skipping (server gate still applies)"
else
  _protected="refs/heads/live-defi-rollout refs/heads/staging refs/heads/main"
  _rc=0
  while read -r _lref _lsha _rref _rsha; do
    [ -z "${_rref:-}" ] && continue
    case " $_protected " in *" $_rref "*) : ;; *) continue ;; esac
    [ "${_lsha:-}" = "0000000000000000000000000000000000000000" ] && continue # branch delete
    if [ "${_rsha:-}" = "0000000000000000000000000000000000000000" ]; then
      _range="$_lsha" # new ref — the guard bounds its own rev-list
    else
      _range="${_rsha}..${_lsha}"
    fi
    python3 "$_guard" --range "$_range" --block || _rc=$?
  done <<<"$STDIN_DATA"
  if [ "${_rc:-0}" -ne 0 ]; then
    echo ""
    echo "  ⛔ pre-push BLOCKED — CODE on a protected branch must go through quickmerge."
    echo "     Ship it:  bash scripts/quickmerge.sh \"<msg>\" --agent --files '<paths>'"
    echo "     CLAUDE.md HARD RULE. The LDR→main provenance gate refuses to PROMOTE bypassed"
    echo "     commits, so a direct push strands the repo (mtds: 26 commits, ~23h) — it saves"
    echo "     nothing. Deps dirty? quickmerge STAGE 0.4/1 is exactly what reconciles them."
    exit "$_rc"
  fi
fi

# ── [2] frontmatter-schema guard (PM only, BLOCKS) ────────────────────────────────────────────
# Closes the `--no-verify` window between a bypassed COMMIT and a red CI. The schema check already
# runs pre-COMMIT (run_hygiene_sweep.sh --precommit, whose comment says it "closes that bypass at
# commit time") — but a pre-commit hook is a LOCAL, single-clone gate: `git commit --no-verify`
# skips it and nothing re-checks frontmatter until CI's lint-codex slice, which then reds the whole
# fleet's PM gate.
#
# Measured 2026-07-18: c1c76beaf (slot-3) landed plans/active/cefi_consolidated_closeout_2026_07_18.md
# with `assigned_role: data` — never a valid role (the enum is agents/*.md filenames;
# data_engineering.md exists, data.md never did). Every link was verified sound: the check IS in the
# pre-commit sweep, the checker DOES exit 1 on that value, the hook IS installed in every clone, and
# the enum never changed — so it was a one-off local bypass. It still reached the shared branch and
# red-lined PM QG for everyone until corrected 20 min later.
#
# PM-ONLY: check_frontmatter_schema.py + its DOC_TREES (plans/**, codex/**, agents/*.md, **/*.mdc)
# are PM-relative; other repos have no such docs. Scoped to the docs ACTUALLY being pushed (the
# range's changed files), so an untouched pre-existing violation elsewhere never blocks your push.
if [ "$REPO_NAME" = "unified-trading-pm" ]; then
  _fm="${REPO_ROOT}/scripts/plan-hygiene/check_frontmatter_schema.py"
  if [ ! -f "$_fm" ]; then
    echo "pre-push: frontmatter schema checker not found — skipping (CI lint-codex still gates)"
  else
    _fm_protected="refs/heads/live-defi-rollout refs/heads/staging refs/heads/main"
    _fm_files=""
    while read -r _lref _lsha _rref _rsha; do
      [ -z "${_rref:-}" ] && continue
      case " $_fm_protected " in *" $_rref "*) : ;; *) continue ;; esac
      [ "${_lsha:-}" = "0000000000000000000000000000000000000000" ] && continue # branch delete
      if [ "${_rsha:-}" = "0000000000000000000000000000000000000000" ]; then
        _fm_rng="$_lsha"
      else
        _fm_rng="${_rsha}..${_lsha}"
      fi
      # Added/Copied/Modified/Renamed only — a DELETED doc has no frontmatter to validate.
      # The tree set MUST cover check_frontmatter_schema.py's DOC_TREES, else a doc in a tree this
      # guard omits (measured 2026-07-21: plans/audit/results, plans/audit/instructions, **/*.mdc
      # were covered by the CI corpus scan but MISSING here) bypasses this client guard yet still
      # reds the fleet-wide PM gate from CI. NOTE on git pathspec semantics: a plain `*` matches `/`,
      # so a single-star `dir/*.md` catches BOTH direct and nested docs (verified) — a `**` form
      # would MISS files directly in the dir. The checker skips any matched non-doc (doc_type=None),
      # so a slightly-broad glob never false-blocks.
      _fm_files="${_fm_files} $(git diff --name-only --diff-filter=ACMR "$_fm_rng" -- \
        'plans/active/*.md' 'plans/active/issues/*.md' 'plans/epics/*.md' \
        'plans/audit/results/*.md' 'plans/audit/instructions/*.md' \
        'codex/*.md' 'agents/*.md' '*.mdc' 2>/dev/null | tr '\n' ' ')"
    done <<<"$STDIN_DATA"
    # De-dup + drop paths deleted in the working tree (a range can name a since-removed file).
    _fm_list=""
    for _f in $_fm_files; do
      [ -f "$REPO_ROOT/$_f" ] || continue
      case " $_fm_list " in *" $_f "*) : ;; *) _fm_list="${_fm_list} $_f" ;; esac
    done
    if [ -n "${_fm_list// /}" ]; then
      # shellcheck disable=SC2086  # intentional word-split: _fm_list is a space-separated path list
      if ! (cd "$REPO_ROOT" && python3 "$_fm" --quiet $_fm_list); then
        echo ""
        echo "  ⛔ pre-push BLOCKED — a doc you are pushing FAILS the frontmatter schema."
        echo "     This is the same check CI's lint-codex slice runs, so pushing it reds PM QG"
        echo "     for the WHOLE FLEET (every repo's CI clones PM). Fix it here, not there."
        echo "     Remedy: python3 scripts/docs/seed_frontmatter.py --apply <path> (derivable"
        echo "     fields), then fill the content fields by hand."
        echo "     Schema: codex/11-project-management/doc-frontmatter-schema.md"
        exit 1
      fi
    fi
  fi
fi

# ── [3] dep-alignment guard (staging only) — original behaviour, unchanged ─────────────────────
# Delegates to check-dep-alignment.py (same logic as quickmerge Stage 0). No-op off staging.
# KEPT because the ldr_main (staging-bypassed) toggle is documented as REVERSIBLE — a breaking
# bump or an operator decision routes a repo back through staging, and this must still fire then.
PUSHING_TO_STAGING=false
while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
  if echo "${remote_ref:-}" | grep -q "refs/heads/staging"; then
    PUSHING_TO_STAGING=true
  fi
done <<<"$STDIN_DATA"

if [ "$PUSHING_TO_STAGING" = false ]; then exit 0; fi

MANIFEST="${_ws}/unified-trading-pm/workspace-manifest.json"
CHECK_SCRIPT="${_ws}/unified-trading-pm/scripts/repo-management/check-dep-alignment.py"

# If no manifest or script found, skip check (graceful degradation)
if [ ! -f "$MANIFEST" ] || [ ! -f "$CHECK_SCRIPT" ]; then
  echo "pre-push: dep-alignment check skipped (manifest or script not found)"
  exit 0
fi

echo "pre-push: checking dep alignment for $REPO_NAME before push to staging..."
python3 "$CHECK_SCRIPT" --repo "$REPO_NAME" --to-staging true --manifest "$MANIFEST"
exit $?
