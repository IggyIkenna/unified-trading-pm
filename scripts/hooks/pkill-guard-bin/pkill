#!/usr/bin/env bash
# Epic: infrastructure_master
# Lifecycle: permanent
# Delete-when: NA
#
# Real, PATH-resolved executable guard wrapper for `pkill` — see ../pkill-guard.sh
# for the actual guard-check logic (shared, unmodified) and
# plans/active/issues/pkill_guard_dead_on_exec_into_claude_recurrence4_2026_08_21.md
# for why a SOURCED shell function alone cannot protect a real agent's Bash-tool
# subprocess: agent-orchestrator's tmux_spawn.py sources pkill-guard.sh into a
# worker pane's bash_cmd, then immediately `exec`s into the `claude` binary — exec
# REPLACES the process image (it does not fork), so any shell function defined in
# that bash process dies with it, and Claude Code's own Bash-tool calls spawn a
# FRESH subshell per invocation that never sourced anything in the first place.
#
# PATH, unlike a shell function, is an environment variable: it survives exec and
# is inherited by every subsequently-spawned child process, including each fresh
# per-tool-call subshell. Placing this directory ahead of the rest of PATH is the
# mechanism that actually reaches the attack surface the guard exists to protect.
set -euo pipefail
_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../pkill-guard.sh
source "${_dir}/../pkill-guard.sh"
_pkill_guard_check "pkill" "$@" || exit 1
exec /usr/bin/pkill "$@"
