# =============================================================================
# Central .gitignore — workspace SSOT (Python + React/TS + security)
# Copy to repo root as .gitignore. Source: unified-trading-pm/scripts/templates/
# =============================================================================

# --- Security (never commit credentials) ---
*credentials*.json
*-credentials.json
*-service-account.json
workspace-dev-sa-key.json
service-account*.json
*secret*.json
central-element-323112-*.json
.env
.env.local
.env.*.local
.env.production
**/secrets/
**/credentials/
*.p12
*.json.bak

# --- Claude Code ephemeral worktrees (Workflow/Agent isolation:"worktree") ---
# Never track: a worktree is its own git repo, so `git add` records it as a dangling
# gitlink (mode 160000) with no matching .gitmodules entry -- every checkout of a repo
# that accidentally committed one prints "fatal: No url found for submodule path ..."
# (harmless warning, but pure noise on every CI job). See
# plans/active/issues/shared_host_home_filesystem_full_2026_07_26.md for the symptom.
.claude/worktrees/

# --- OS / editor ---
.DS_Store
.DS_Store?
Thumbs.db
*.backup
*~
*.swp
*.swo
.idea/
.vscode/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.hypothesis/
.ruff_cache/
.cache/
*.egg-info/
.eggs/
*.egg
*.so
.Python
.tox/
.nox/
.pyre/
.pytype/
.ropeproject
.spyderproject
.spyproject

# --- Python venvs ---
.venv/
.venv*/
venv/
venv*/
.venv-workspace/
ENV/
env/

# --- Node / React / TypeScript ---
# No trailing slash — matches a node_modules dir OR symlink (per-slot worktrees symlink it).
node_modules
.next/
dist/
build/
.turbo/
.nyc_output/

# --- Coverage / test artifacts ---
.coverage
.coverage.*
coverage/
coverage.xml
htmlcov/
nosetests.xml

# --- QG run PID file (repo-scoped self-kill handle; overwritten every run;
#     pkill_broad_pattern_cross_slot_qg_kill_2026_07_28.md P2) ---
/.qg_run.pid

# --- Data / logs (repo-local, not for git) ---
data/
logs/
*.log

# --- Common data / document file types (generated or local, not for git) ---
# Uncomment or add !tests/fixtures/*.csv if the repo commits CSV fixtures
*.csv
*.xlsx
*.xls
*.xlsm
*.ppt
*.pptx
*.pptm
*.doc
*.docx
*.docm
*.pdf
*.parquet
*.tsv
*.ods
*.odt
*.odp

