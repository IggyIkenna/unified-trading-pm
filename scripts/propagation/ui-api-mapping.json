{
  "$comment": "Per-UI primary API mapping for advisory coverage checks (check-ui-api-coverage.sh). Archived split UIs and batch-audit-api live under workspace-root archive/. See scripts/dev/ui-api-mapping.json for dev stack pairings.",
  "deployment-ui": {
    "api_name": "deployment-api",
    "env_var": "INTEGRATION_TEST_API_URL",
    "default_port": "8004",
    "api_path": "/api",
    "endpoints": [
      "/health",
      "/services",
      "/services/{service_name}",
      "/services/{service_name}/dimensions",
      "/services/{service_name}/discover-configs",
      "/services/{service_name}/list-directories",
      "/services/{service_name}/config-buckets",
      "/config/region",
      "/config/validate-region",
      "/config/venues",
      "/config/venues/{category}",
      "/config/expected-start-dates",
      "/deployments",
      "/service-status/overview",
      "/service-status/{service}/status",
      "/service-status/execution-service/data-status",
      "/data-status",
      "/data-status/last-updated",
      "/data-status/turbo",
      "/data-status/turbo/stats",
      "/data-status/venue-filters",
      "/data-status/list-files",
      "/data-status/instruments",
      "/data-status/instrument-availability",
      "/capabilities",
      "/checklists",
      "/checklists/{service_name}/checklist",
      "/checklists/{service_name}/checklist/validate",
      "/epics",
      "/cloud-builds/triggers",
      "/api/builds/{service}",
      "/api/deployments/{service}/deploy",
      "/users",
      "/users/{user_id}",
      "/roles",
      "/permissions",
      "/commentary/pipeline-uat"
    ]
  },
  "unified-trading-system-ui": {
    "api_name": "unified-trading-api",
    "env_var": "INTEGRATION_TEST_UNIFIED_TRADING_URL",
    "default_port": "8030",
    "api_path": "/api",
    "endpoints": ["/health", "/readiness"],
    "note": "Consolidated UI. Domain traffic goes to unified-trading-api; auth-api, deployment-api, client-reporting-api are additional backends \u2014 see scripts/dev/ui-api-mapping.json stacks."
  }
}
