[Unit]
Description=Refresh the glue-runner GitHub token cache from GCP Secret Manager
Documentation=file:///opt/github-glue-runners/refresh-gh-token.sh
# The runners read the cache this unit writes; ordering is advisory only, because the wrapper falls
# back to a direct Secret Manager read when the cache is absent (first boot before the timer fires).
Before=github-glue-runner@.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu

# Creates /run/github-glue-runner owned by User=, mode 0700. tmpfs => the PAT is RAM-only: never on
# the EBS volume, never in a snapshot, gone on reboot (the timer's OnBootSec re-creates it).
RuntimeDirectory=github-glue-runner
RuntimeDirectoryMode=0700
# LOAD-BEARING: without this, systemd deletes /run/github-glue-runner the instant this oneshot exits
# — taking the token with it and leaving every runner with an empty cache.
RuntimeDirectoryPreserve=yes

Environment=GH_TOKEN_SECRET=GH_PAT
Environment=GCP_PROJECT=central-element-323112
Environment=GH_TOKEN_FILE=/run/github-glue-runner/gh_token
Environment=PATH=/opt/github-glue-runners/venv/bin:/home/ubuntu/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/snap/bin

ExecStart=/opt/github-glue-runners/refresh-gh-token.sh

# A failed refresh is NOT fatal: refresh-gh-token.sh keeps the last good token, so the pool keeps
# running on a slightly stale (but valid — GH_PAT never expires) credential. The non-zero exit is
# recorded in the journal so the failure is visible rather than silent.
SuccessExitStatus=0

[Install]
WantedBy=multi-user.target
