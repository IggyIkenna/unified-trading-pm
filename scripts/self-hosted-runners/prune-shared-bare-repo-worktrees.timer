# prune-shared-bare-repo-worktrees.timer — hourly backstop sweep of the shared bare-repo
# dep-clone cache (Part 4/8's explicit "git worktree prune on a timer" requirement:
# plans/active/issues/ci_vm_io_starvation_audit_findings_and_optimization_2026_08_05.md).
#
# Epic: ci_master
# Lifecycle: permanent   Delete-when: shared bare-repo dep-clone fast path retired
#
# Cadence rationale: the fast path's own opportunistic prune (before every fetch) is the primary
# hygiene mechanism, so this rarely finds anything to do — hourly is cheap insurance against the
# leak-when-idle case (a bare repo whose dep repo drops out of use), matching
# ci-vm-resource-watchdog.timer's hourly cadence for the same reason (a standing safety sweep,
# not a hot path).
[Unit]
Description=Hourly prune of stale git-worktree entries in the shared bare-repo dep-clone cache

[Timer]
OnBootSec=5min
OnUnitActiveSec=1h
Persistent=true
Unit=prune-shared-bare-repo-worktrees.service

[Install]
WantedBy=timers.target
