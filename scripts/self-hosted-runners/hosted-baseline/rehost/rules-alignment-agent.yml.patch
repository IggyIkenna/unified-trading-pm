-          #   run 29556693095 05:11 = last no-op SUCCESS; 29559227122 06:09 onwards = hourly CRITICAL.
-          # So this was a latent misconfiguration a routine upstream release exposed, not a
-          # regression in the workflow or the package.
-          #
-          # Fix: install under a USER-WRITABLE prefix instead of touching /usr/lib. This mirrors the
-          # convention already in place on the dev hosts (`npm config get prefix` there is already
-          # /home/<user>/.npm-global). Set via env, NOT `npm config set`, so we do not mutate the
-          # shared runner's global npm state. plan-health-agent.yml does the same install but on
-          # ubuntu-latest, where the runner user CAN write the default prefix — it is unaffected.
-          export NPM_CONFIG_PREFIX="${HOME}/.npm-global"
-          mkdir -p "${NPM_CONFIG_PREFIX}/bin"
