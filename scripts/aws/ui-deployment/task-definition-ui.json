{
  "_comment": "ECS Fargate task definition for unified-trading-system-ui live-trading dashboard tier (latency-sensitive).",
  "_staging_note": "Staged in unified-trading-pm/scripts/aws/ui-deployment/. Copy to unified-trading-system-ui/.aws/ when that repo is available.",
  "_register_cmd": "aws ecs register-task-definition --cli-input-json file://task-definition-ui.json --region ap-northeast-1",
  "family": "uts-trading-ui",
  "executionRoleArn": "arn:aws:iam::427895769566:role/uts-ecs-task-execution-role",
  "taskRoleArn": "arn:aws:iam::427895769566:role/uts-ecs-task-role",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "containerDefinitions": [
    {
      "name": "unified-trading-system-ui",
      "image": "427895769566.dkr.ecr.ap-northeast-1.amazonaws.com/unified-trading-system-ui:latest",
      "portMappings": [
        {
          "containerPort": 3000,
          "hostPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "NEXT_PUBLIC_CLOUD_PROVIDER", "value": "aws" },
        { "name": "CLOUD_PROVIDER", "value": "aws" },
        { "name": "CLOUD_MOCK_MODE", "value": "false" },
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT", "value": "3000" }
      ],
      "secrets": [
        {
          "name": "NEXT_PUBLIC_API_BASE_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-1:427895769566:secret:unified-trading/ui/api-base-url"
        },
        {
          "name": "NEXT_PUBLIC_DEPLOYMENT_API_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-1:427895769566:secret:unified-trading/ui/deployment-api-url"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:3000/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/unified-trading-system-ui",
          "awslogs-region": "ap-northeast-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "essential": true
    }
  ],
  "tags": [
    { "key": "env", "value": "prod" },
    { "key": "service", "value": "unified-trading-system-ui" },
    { "key": "cloud", "value": "aws" },
    { "key": "tier", "value": "fargate-live-trading" }
  ]
}
