## DO:

  # ML service needs instrument definition schema → import from UIC
  from unified_internal_contracts.reference.instrument_definition import InstrumentDefinition

  # ML service needs instrument data at runtime → use domain client (never import instruments-service)
  from unified_domain_client import InstrumentsDomainClient
  instruments = InstrumentsDomainClient(storage_client)
  record: InstrumentDefinition = await instruments.get(instrument_key)

  # Service output schema → define in UIC
  # unified-internal-contracts/unified_internal_contracts/domain/my_service/output.py
  class MyServiceRecord(BaseModel):
      instrument_key: str
      value: Decimal

## NEVER:

  # BAD: service defines its own InstrumentDefinition
  class InstrumentDefinition(BaseModel):  # ← in ml_inference_service/models.py
      symbol: str
      venue: str

  # BAD: service imports another service (tier DAG violation)
  from instruments_service.models import InstrumentDefinition  # ← T4 importing T4

  # BAD: library or interface defines a cross-repo domain schema
  class CanonicalTicker(BaseModel):  # ← in unified_market_interface/schemas.py
      ...  # MISPLACE-UAC: canonical normalization outputs live in UAC unified_normalised_contracts/

  # BAD: adapter-private model kept in interface repo
  class _DeribitModels(BaseModel):  # ← in unified_market_interface/adapters/_deribit_models.py
      ...  # MISPLACE-UAC: external API parsers belong in UAC unified_api_contracts_external/deribit/
