## Cross-Linking Pattern

```tsx
// Entity names are always clickable portals
import { EntityLink } from "@unified-trading/ui-kit";

<EntityLink type="strategy" id="BTC_BASIS_V3">BTC Basis v3</EntityLink>
// → links to Strategy Analytics /strategies/BTC_BASIS_V3

<EntityLink type="client" id="blue-coast">Blue Coast Capital</EntityLink>
// → links to Market Intelligence /pnl/client/blue-coast
```

```tsx
// Cross-surface links with context preservation
import { buildCrossLink } from "@unified-trading/ui-kit";

const url = buildCrossLink("strategyAnalytics", "/strategies/BTC_BASIS_V3", {
  client_id: "blue-coast",
  from: "trading"
});
```

