  "topologicalOrder": {
    "description": "Order for cascading quickmerge (dependencies BEFORE dependents). Drives CI/CD checkout order.",
    "levels": [
      {
        "level": 0,
        "description": "Foundation \u2014 no dependencies",
        "repos": [
          "unified-config-interface",
          "unified-events-interface",
          "unified-cloud-interface",
          "api-contracts",
          "unified-internal-contracts",
          "unified-reference-data-interface",
          "unified-trading-codex"
        ]
      },
      {
        "level": 1,
        "description": "Cloud services",
        "repos": [
          "unified-trading-services"
        ]
      },
      {
        "level": 2,
        "description": "Domain services and pure libraries",
        "repos": [
          "unified-domain-client",
          "execution-algo-library",
          "unified-feature-calculator-library"
        ]
      },
      {
        "level": 3,
        "description": "Interfaces and engine libraries",
        "repos": [
          "unified-market-interface",
          "unified-ml-interface",
          "unified-trade-execution-interface",
          "unified-position-interface",
          "matching-engine-library"
        ]
      },
      {
        "level": 4,
        "description": "DeFi interface",
        "repos": [
          "unified-defi-execution-interface"
        ]
      },
      {
        "level": 5,
        "description": "Core services",
        "repos": [
          "instruments-service",
          "market-tick-data-handler",
          "ml-training-service"
        ]
      },
      {
        "level": 6,
        "description": "Services with service dependencies",
        "repos": [
          "strategy-service",
          "market-data-processing-service",
          "ml-inference-service",
          "features-calendar-service",
          "features-delta-one-service",
          "features-onchain-service",
          "features-volatility-service",
          "pnl-attribution-service",
          "alerting-system",
          "unified-trading-deployment-v3",
          "execution-services"
        ]
      },
      {
        "level": 7,
        "description": "Operational services that depend on execution",
        "repos": [
          "position-balance-monitor-service",
          "risk-and-exposure-service",
          "strategy-validation-service"
        ]
      },
      {
        "level": 8,
        "description": "UI services",
        "repos": [
          "backtest-ui",
          "batch-audit-ui",
          "trading-analytics-ui",
          "live-health-monitor-ui",
          "client-reporting-ui",
          "logs-dashboard-ui",
          "ml-deployment-ui",
          "onboarding-ui",
          "settlement-ui"
        ]
      }
    ]
  },
  "tier_rules": {
    "0": {
      "allowed_from": [],
      "description": "Pure leaf \u2014 no inter-library imports"
    },
    "1": {
      "allowed_from": [
        "0"
      ],
      "description": "Service runtime \u2014 imports Tier 0 only"
    },
    "2": {
      "allowed_from": [
        "0"
      ],
      "description": "Domain libs \u2014 imports Tier 0 only, no Tier 1"
    },
    "service": {
      "allowed_from": [
        "0",
        "1",
        "2"
      ],
      "description": "Services import from all tiers"
    },
    "ui": {
      "allowed_from": [],
      "description": "TypeScript \u2014 separate QG rules"
    }
  },
