        ],
        "reason": "Depends only on api-contracts. GitHub repo renamed from unified-trading-services."
      },
      {
        "step": 3,
        "packages": [
          "unified-domain-client",
          "execution-algo-library",
          "unified-feature-calculator-library"
        ],
        "reason": "Depend on cloud services"
      },
      {
        "step": 4,
        "packages": [
          "unified-market-interface",
          "unified-ml-interface",
          "unified-trade-execution-interface",
          "matching-engine-library"
        ],
        "reason": "Depend on domain services"
      },
      {
        "step": 5,
        "packages": [
          "unified-defi-execution-interface",
          "unified-position-interface"
        ],
        "reason": "Depend on market/execution interfaces"
      },
      {
        "step": 6,
        "packages": [
          "All services"
        ],
        "reason": "Can be published once all libraries are available"
      }
    ]
  }
