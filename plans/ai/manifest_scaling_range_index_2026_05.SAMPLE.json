{
  "_doc": {
    "purpose": "Concrete row shape for the per-asset-group, per-layer range-index files proposed in manifest_scaling_range_index_2026_05.plan.md",
    "principle": "One bucket per asset_group, one _index/range_index.parquet per (bucket, layer). Each bucket's index has its own schema — sports does not pretend to share columns with cefi.",
    "data_sources": {
      "cefi_layer_1": "Sampled from gs://instruments-store-cefi-central-element-323112/instrument_availability/by_date/day=2026-04-13/venue=*/instruments.parquet on 2026-04-30. Real values, real columns from UAC InstrumentRecord.",
      "tradfi_layer_1": "Sampled from gs://instruments-store-tradfi-central-element-323112/instrument_availability/by_date/day=2026-04-10/venue=*/instruments.parquet. Real values.",
      "defi_layer_1": "PROPOSED — see open question Q1 in plan. instruments-service has not shipped a per-instrument parquet under instrument_availability/ for DEFI; only manifest rows exist. The shape below is extrapolated from UAC InstrumentRecord schema (DEFI-relevant columns) but no real parquet on disk matches it today. Marked _proposed=true throughout.",
      "sports_layer_1": "PROPOSED — see open question Q2 in plan. Sports today writes to a different layout (gs://instruments-store-sports-central-element-323112/sports_reference/by_date/day=*/entity=fixtures/fixtures.parquet) with api-football-prefixed columns (af_fixture_id, af_home_id, af_league_id). Whether the range-index pattern applies, and how to map api-football's column names into a canonical shape, needs sports-domain owner input.",
      "prediction_layer_1": "Sampled from gs://instruments-store-prediction-central-element-323112/instrument_availability/by_date/day=2028-11-07/venue=POLYMARKET/instruments.parquet on 2026-04-30. Real columns (47 of them in the source). The sample below shows a representative subset; the full schema includes order-book hints (best_bid, best_ask, spread), volume metrics, tags, etc.",
      "all_layer_2": "PROPOSED — Layer 2 (raw range index) does NOT EXIST on disk anywhere today. This plan is what creates it. All Layer 2 rows below are marked _proposed=true and represent what the compactor would emit when run.",
      "all_layer_3": "PROPOSED — same as Layer 2. Layer 3 (processed range index) does not exist today; emitted by the compactor."
    },
    "common_columns_all_layers": {
      "covered_from": "ISO date (or timestamp for sub-daily windows like sports) — first day with confirmed coverage",
      "covered_to": "ISO date — last day with confirmed coverage",
      "gap_dates": "list[ISO date] — pipeline failures (NOT weekends/holidays). Holidays come from instrument's calendar (regular_open_utc, holiday_calendar fields), not this list.",
      "shard_count": "int — number of underlying GCS shards this row summarises",
      "bytes_total": "int — sum of bytes across all underlying shards. Free at write time (compactor's existing list_blobs response carries blob.size).",
      "last_compacted_at": "ISO timestamp UTC — when the nightly compactor wrote this row",
      "instrument_key": "canonical UAC instrument key (`venue:instrument_type:symbol[-suffix]`) — the FK to Layer 1"
    },
    "fk_invariants": [
      "every Layer 3 (processed) row has its (asset_group, instrument_key, data_type) covered by a Layer 2 row in the matching bucket",
      "every Layer 2 (raw) row has its instrument_key covered by a Layer 1 row in the matching asset_group bucket",
      "violations raise alerts in the compactor; do not silently break reads"
    ],
    "open_questions": "Captured in manifest_scaling_range_index_2026_05.plan.md §'Open questions for reviewers' — Q1 (DEFI Layer 1 path), Q2 (SPORTS Layer 1 schema), Q3 (Layers 2+3 SSOT location), Q4 (bytes_total worth keeping), Q5 (per-group schemas), Q5b (TRADFI cash-equity instrument_type='SPOT_PAIR' vs 'EQUITY'), Q5c (available_from_datetime semantics)."
  },

