{
  "include": ["scripts"],
  "typeCheckingMode": "standard",
  "reportImplicitOverride": "none",
  "reportExplicitAny": "none",
  "reportAny": "error",
  "reportUnknownArgumentType": "none",
  "reportUnknownVariableType": "none",
  "reportUnknownMemberType": "none",
  "reportUnknownParameterType": "none",
  "reportUnnecessaryComparison": "warning",
  "reportUnreachable": "warning",
  "exclude": ["scripts/migration", "scripts/manifest/sbom-store.py", "tests"],
  "ignore": [
    "scripts/propagation/rollout-buildspec.py",
    "scripts/propagation/rollout-cloudbuild.py",
    "scripts/propagation/add-cloudbuild-deploy-via-dispatch.py",
    "scripts/validation/check_manifest_import_alignment.py",
    "scripts/validation/check_schema_provenance.py",
    "scripts/validation/validate-build-auth.py",
    "scripts/manifest/reverse-dependency-lookup.py",
    "scripts/manifest/auto-populate-tags.py",
    "scripts/manifest/check-strategy-instruments.py",
    "scripts/manifest/check-strategy-maturity.py",
    "scripts/checkers/check-data-availability.py",
    "scripts/checkers/check-strategy-maturity.py",
    "scripts/checkers/check_ui_api_flow_coverage.py",
    "scripts/checkers/fixture_drift_checker.py",
    "scripts/checkers/flow_coverage_scorecard.py",
    "scripts/checkers/network_evidence_parser.py",
    "scripts/checkers/triad_assertion_checker.py",
    "scripts/generators/generate_dependency_viz.py",
    "scripts/generators/generate_strategy_manifest_dag.py",
    "scripts/generators/reverse-dependency-lookup.py",
    "scripts/quality_gates/snapshot_to_parquet.py",
    "scripts/quality_gates/check_snapshot_staleness.py"
  ],
  "extraPaths": ["../unified-internal-contracts", "../unified-api-contracts"],
  "venvPath": ".",
  "venv": ".venv",
  "pythonVersion": "3.13"
}
